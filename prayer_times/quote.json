
{
  "2026-07-26": {
    "text": "যে ব্যক্তি আল্লাহর উপর ভরসা করে, আল্লাহ তার জন্য যথেষ্ট।",
    "reference": "সূরা আত-তালাক ৬৫:৩"
  },

  "2026-07-27": {
    "text": "ধৈর্য মুমিনের সবচেয়ে বড় শক্তি।",
    "reference": "ইসলামিক বাণী"
  },

  "2026-07-28": {
    "text": "আল্লাহর স্মরণেই অন্তরের প্রশান্তি।",
    "reference": "সূরা রা'দ ১৩:২৮"
  }
}
