
{
  "2026-07-26": {
    "text": "তোমাদের মধ্যে সেই ব্যক্তি উত্তম, যে কুরআন শিক্ষা করে এবং অন্যকে শিক্ষা দেয়।",
    "reference": "সহিহ বুখারি"
  },

  "2026-07-27": {
    "text": "হাসিমুখে কথা বলাও একটি সদকা।",
    "reference": "তিরমিজি"
  },

  "2026-07-28": {
    "text": "পবিত্রতা ঈমানের অর্ধেক।",
    "reference": "সহিহ মুসলিম"
  }
}
